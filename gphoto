async function addFiles(list) {
  let files = [...list];
  const total = files.length;
  files = files.filter(f => (f.type || '').startsWith('image/') || IMG_EXT.test(f.name));
  const notImg = total - files.length;
  const before = files.length;
  files = files.filter(f => !items.some(it => it.file.name === f.name && it.file.size === f.size && it.file.lastModified === f.lastModified));
  const dup = before - files.length;
  files.sort((a, b) => a.name.localeCompare(b.name, 'ko', {numeric: true}));
  const news = files.map(newItem);
