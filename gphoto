<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#F7F3EC">
<title>사진 좌우반전 도구</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<style>
:root{
  --ground:#F7F3EC;--paper:#FFFDF8;--sand:#EDE3D5;--line:#E3D8C8;--ink:#2C2925;--muted:#7B7167;
  --brown:#8A6A53;--brown-deep:#6F5240;--green:#2E5B45;--green-deep:#244A38;--green-soft:#E1EBE2;--bad:#B3261E;--radius:16px;
  --sans:'Pretendard Variable',Pretendard,-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic',system-ui,sans-serif;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5;word-break:keep-all;color-scheme:light}
button,input{font:inherit;color:inherit}
svg.i{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* 버튼 */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:50px;padding:0 18px;border-radius:12px;border:1px solid var(--line);background:var(--paper);font-weight:700;font-size:15px;cursor:pointer;transition:background .15s,opacity .15s;white-space:nowrap}
.btn:hover{background:#fff}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.primary{background:var(--green);border-color:var(--green);color:#fff}
.btn.primary:hover{background:var(--green-deep)}
.btn.sm{height:38px;padding:0 12px;font-size:14px;border-radius:10px}
.mini{height:30px;padding:0 10px;border:1px solid var(--line);border-radius:8px;background:none;font-size:12.5px;font-weight:600;color:var(--muted);cursor:pointer;white-space:nowrap}
.mini:hover{background:#fff;color:var(--ink)}
.mini:disabled{opacity:.4;cursor:default;background:none;color:var(--muted)}
.ic{width:32px;height:32px;flex:none;border:0;border-radius:8px;background:none;color:var(--muted);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.ic:hover{background:var(--sand);color:var(--ink)}
.ic.del:hover{color:var(--bad)}

/* 두 칸 배치 (왼쪽 사진, 오른쪽 설정) */
.top{padding:6px 4px 14px}
.top h1{font-size:20px;margin:0;color:var(--brown-deep);line-height:1.3}
.top p{margin:2px 0 0;font-size:13.5px;color:var(--muted)}
.layout{max-width:1280px;margin:0 auto;padding:14px 20px 48px;display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px;align-items:start}
.main-col{min-width:0}
.side{position:sticky;top:14px;display:grid;gap:12px;max-height:calc(100vh - 28px);overflow:auto;border-radius:var(--radius)}
.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:16px}
.card h2{font-size:14px;margin:0 0 12px;color:var(--brown-deep);display:flex;justify-content:space-between;align-items:center;gap:8px}
.hint{margin:8px 0 0;font-size:12.5px;color:var(--muted);line-height:1.55}

/* 사진 목록 */
.ph-head{display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.ph-head h2{margin:0;flex:1;font-size:16px;color:var(--ink)}
.ph-head h2 small{font-size:13px;font-weight:600;color:var(--muted)}
.drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-height:380px;border:2px dashed var(--line);border-radius:14px;background:#FBF8F2;text-align:center;cursor:pointer;padding:24px;transition:border-color .15s,background .15s}
.drop:hover{border-color:var(--brown);background:#fff}
.drop .big{width:60px;height:60px;border-radius:18px;background:var(--green-soft);color:var(--green);display:flex;align-items:center;justify-content:center}
.drop .big svg.i{width:28px;height:28px}
.drop b{font-size:18px}
.drop span{font-size:13.5px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:12px}
.ph{border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;display:flex;flex-direction:column}
.ph-img{position:relative;display:block;width:100%;aspect-ratio:1;border:0;padding:0;background:#F1EBE1;cursor:pointer;transition:background .15s}
.ph-img:hover{background:#E9DFD0}
.ph-img:focus-visible{outline:2px solid var(--brown);outline-offset:-2px}
.ph-img .in{position:absolute;inset:8px;display:flex;align-items:center;justify-content:center}
.ph-img canvas{display:block;width:100%;height:100%;object-fit:contain}
.ph-img .badge{position:absolute;left:8px;top:8px;background:var(--brown-deep);color:#fff;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:999px}
.ph:not(.own) .badge{display:none}
.ph.loading .ph-img{cursor:progress}
.ph-bar{display:flex;align-items:center;gap:2px;padding:6px 6px 6px 10px;border-top:1px solid var(--line)}
.ph-name{flex:1;min-width:0;font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.spin{width:28px;height:28px;border:3px solid var(--line);border-top-color:var(--brown);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.add-tile{min-height:220px;border:1.5px dashed var(--line);border-radius:12px;background:transparent;color:var(--brown-deep);font-weight:700;font-size:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:background .15s,border-color .15s}
.add-tile:hover{background:#fff;border-color:var(--brown)}
.add-tile svg.i{width:24px;height:24px}

/* 조정 칸 (모든 사진 / 한 장 따로 — 같은 모양) */
.ctl{padding:12px 0;border-top:1px solid var(--line)}
.ctl:first-child{border-top:0;padding-top:0}
.ctl:last-child{padding-bottom:0}
.ctl-label{font-weight:700;font-size:14px}
.ctl > .ctl-label{display:block;margin-bottom:8px}
.ctl-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px}
.sub-label{display:block;font-size:13px;font-weight:700;margin:12px 0 6px}
.togs{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tog{height:42px;border:1px solid var(--line);border-radius:12px;background:#fff;font-weight:700;font-size:14px;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;color:var(--muted);transition:background .15s,color .15s}
.tog:hover{color:var(--ink);border-color:var(--brown)}
.tog[aria-pressed=true]{background:var(--green);border-color:var(--green);color:#fff}
.rots{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.seg{display:grid;grid-template-columns:repeat(var(--n,2),minmax(0,1fr));gap:4px;background:var(--sand);padding:4px;border-radius:12px}
.seg button{height:36px;border:0;background:none;border-radius:9px;font-size:13.5px;font-weight:700;color:var(--muted);cursor:pointer;padding:0 4px;white-space:nowrap}
.seg button:hover{color:var(--ink)}
.seg button[aria-pressed=true]{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.08)}

/* 슬라이더 한 줄: 이름 | 막대 | 숫자 | 되돌리기 */
.sl{display:grid;grid-template-columns:46px minmax(0,1fr) 52px 26px;align-items:center;gap:6px;min-height:36px}
.sl-l{font-size:13.5px;font-weight:600;white-space:nowrap}
.sl input[type=range]{-webkit-appearance:none;appearance:none;display:block;width:100%;height:28px;margin:0;background:transparent;cursor:pointer;--track:var(--sand)}
.sl input[type=range]:focus{outline:none}
.sl input[type=range]::-webkit-slider-runnable-track{height:5px;border-radius:5px;background:var(--track)}
.sl input[type=range]::-moz-range-track{height:5px;border-radius:5px;background:var(--track)}
.sl input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;margin-top:-6.5px;border-radius:50%;background:#fff;border:2px solid var(--green);box-shadow:0 1px 3px rgba(0,0,0,.2)}
.sl input[type=range]::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:#fff;border:2px solid var(--green)}
.sl input[type=range]:focus-visible::-webkit-slider-thumb{box-shadow:0 0 0 4px rgba(138,106,83,.3)}
.sl-n{width:52px;height:30px;border:1px solid var(--line);border-radius:8px;background:#fff;text-align:right;padding:0 7px;font-size:14px;font-variant-numeric:tabular-nums;-moz-appearance:textfield;appearance:textfield}
.sl-n::-webkit-inner-spin-button,.sl-n::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
.sl-n:focus{outline:2px solid var(--brown);outline-offset:-1px;border-color:var(--brown)}
.sl-x{width:26px;height:26px;padding:0;border:0;border-radius:7px;background:none;color:var(--muted);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.sl-x svg.i{width:14px;height:14px}
.sl-x:hover{background:var(--sand);color:var(--ink)}

/* 저장 — PC에서는 오른쪽 칸 맨 아래에 항상 보이게 고정 */
.frow{display:grid;grid-template-columns:44px minmax(0,1fr);align-items:center;gap:8px}
.frow + .frow{margin-top:8px}
.txt{width:100%;height:40px;border:1px solid var(--line);border-radius:10px;background:#fff;padding:0 12px;font-size:15px}
.txt:focus{outline:2px solid var(--brown);outline-offset:-1px;border-color:var(--brown)}
.save .seg button{height:32px;font-size:13px}
.save .hint{margin-top:6px}
.save-btns{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:8px;margin-top:12px}
.save-btns .btn{padding:0 10px;font-size:14.5px}
.prog{margin-top:12px}
.bar{height:8px;background:var(--sand);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--green);transition:width .2s}
.prog p{margin:6px 0 0;font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}
@media (min-width:901px){
  .side .save{position:sticky;bottom:0;z-index:1;box-shadow:0 -10px 18px -14px rgba(60,40,20,.35)}
}

/* 한 장 따로 조정 창 */
dialog.ed{padding:0;border:0;border-radius:18px;width:min(1280px,calc(100vw - 32px));height:min(880px,calc(100vh - 32px));max-width:none;max-height:none;background:var(--paper);color:var(--ink);overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.35)}
dialog.ed::backdrop{background:rgba(30,26,22,.62)}
.ed-in{display:grid;grid-template-columns:minmax(0,1fr) 340px;height:100%}
.ed-view{position:relative;background:#2B2622;min-height:0}
.ed-stage{position:absolute;inset:20px 68px 66px}
.ed-stage canvas{display:block;width:100%;height:100%;object-fit:contain}
.gridov{position:absolute;pointer-events:none;outline:1px solid rgba(255,255,255,.55);background-image:linear-gradient(rgba(255,255,255,.55) 1px,rgba(0,0,0,.2) 1px,rgba(0,0,0,.2) 2px,transparent 2px),linear-gradient(90deg,rgba(255,255,255,.55) 1px,rgba(0,0,0,.2) 1px,rgba(0,0,0,.2) 2px,transparent 2px);background-size:56px 56px;background-position:center}
.nav{position:absolute;top:calc(50% - 22px);width:44px;height:44px;border-radius:50%;border:0;background:rgba(255,255,255,.14);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer}
.nav svg.i{width:24px;height:24px}
.nav:hover{background:rgba(255,255,255,.26)}
.nav:disabled{opacity:.2;cursor:default;background:rgba(255,255,255,.14)}
.nav.prev{left:12px}.nav.next{right:12px}
.ed-foot{position:absolute;left:0;right:0;bottom:16px;display:flex;justify-content:center;align-items:center;gap:10px;color:#E8E0D6;font-size:13px;font-variant-numeric:tabular-nums}
.ed-foot #edCount{margin-right:4px}
.hold{height:36px;padding:0 14px;border-radius:99px;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.08);color:#fff;font-size:13px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;user-select:none;-webkit-user-select:none;touch-action:none}
.hold:hover{background:rgba(255,255,255,.16)}
.hold.on,.hold[aria-pressed=true]{background:#fff;color:var(--ink)}
.ed-side{display:flex;flex-direction:column;min-height:0;border-left:1px solid var(--line)}
.ed-head{display:flex;align-items:center;gap:8px;padding:12px 10px 12px 18px;border-bottom:1px solid var(--line)}
.ed-head b{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:14.5px}
.ed-body{flex:1;overflow:auto;padding:14px 18px 16px}
.ed-mode{font-size:13px;padding:9px 12px;border-radius:10px;background:var(--sand);color:var(--muted);margin:0 0 14px;line-height:1.5;min-height:57.5px;display:flex;align-items:center}
.ed-mode.own{background:#F3E6D6;color:var(--brown-deep);font-weight:700}
.ed-acts{display:grid;gap:8px;padding:12px 18px 16px;border-top:1px solid var(--line)}
.ed-acts .two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ed-acts .two .btn{padding:0 6px;font-size:13.5px}

/* 끌어다 놓기 · 알림 */
.dropcover{position:fixed;inset:12px;border:3px dashed var(--green);border-radius:20px;background:rgba(247,243,236,.93);display:flex;align-items:center;justify-content:center;font-size:21px;font-weight:800;color:var(--green);z-index:999;pointer-events:none}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,16px);background:var(--ink);color:#fff;padding:11px 18px;border-radius:12px;font-size:14px;line-height:1.5;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:1000;width:max-content;max-width:calc(100vw - 32px);text-align:center}
.toast.show{opacity:1;transform:translate(-50%,0)}

@media (max-width:900px){
  .layout{grid-template-columns:minmax(0,1fr)}
  .side{position:static;max-height:none;overflow:visible}
}
@media (max-width:760px){
  dialog.ed{width:100vw;height:100vh;height:100dvh;border-radius:0}
  .ed-in{grid-template-columns:minmax(0,1fr);grid-template-rows:44vh minmax(0,1fr)}
  .ed-side{border-left:0}
  .ed-stage{inset:12px 54px 58px}
  .nav{width:38px;height:38px;top:calc(50% - 40px)}
  .nav.prev{left:8px}.nav.next{right:8px}
  .hold{padding:0 11px}
}
@media (max-width:560px){
  .top{padding:4px 2px 12px}
  .layout{padding:12px 16px 32px}
  .grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}
  .drop{min-height:260px}
}
</style>
</head>
<body>

<div class="layout">
  <div class="main-col">
  <header class="top">
    <h1>사진 좌우반전 · 보정</h1>
    <p>사진 여러 장을 한 번에 좌우반전하고, 밝기·선명도·색감·각도를 맞춰서 저장해요.</p>
  </header>
  <main class="card">
    <div class="ph-head">
      <h2 id="count">사진</h2>
      <button type="button" class="btn sm" id="addBtn" data-ico="plus">사진 추가</button>
      <button type="button" class="btn sm" id="clearBtn" data-ico="trash">모두 빼기</button>
    </div>
    <label class="drop" id="drop" for="file">
      <span class="big" data-ico="up"></span>
      <b>사진을 여기로 끌어다 놓으세요</b>
      <span>또는 여기를 눌러서 고르기 · 여러 장(폴더째도) 한 번에 넣을 수 있어요</span>
    </label>
    <div class="grid" id="grid" hidden>
      <button type="button" class="add-tile" id="addTile" data-ico="plus">사진 더 넣기</button>
    </div>
  </main>
  </div>

  <aside class="side">
    <section class="card">
      <h2>모든 사진 설정 <button type="button" class="mini" id="gReset">처음으로</button></h2>
      <div id="gctl"></div>
      <p class="hint" id="gNote"></p>
    </section>

    <section class="card save">
      <h2>저장</h2>
      <div class="frow">
        <span class="ctl-label">형식</span>
        <div class="seg" style="--n:3">
          <button type="button" data-fmt="same">원본과 같게</button>
          <button type="button" data-fmt="jpg">JPG</button>
          <button type="button" data-fmt="png">PNG</button>
        </div>
      </div>
      <div class="frow">
        <span class="ctl-label">크기</span>
        <div class="seg" style="--n:3">
          <button type="button" data-size="0" title="찍은 크기 그대로">원본</button>
          <button type="button" data-size="2000" title="긴 쪽을 2000픽셀로 줄임 (블로그용)">긴 쪽 2000</button>
          <button type="button" data-size="1080" title="긴 쪽을 1080픽셀로 줄임 (인스타용)">긴 쪽 1080</button>
        </div>
      </div>
      <div class="frow">
        <label class="ctl-label" for="suffix">이름</label>
        <input type="text" class="txt" id="suffix" maxlength="30" placeholder="원래 이름 뒤에 붙일 글자" autocomplete="off" title="원래 파일 이름 뒤에 붙일 글자 (비워 두면 원래 이름 그대로)">
      </div>
      <p class="hint" id="nameEx"></p>
      <div class="save-btns">
        <button type="button" class="btn primary" id="zipBtn" data-ico="down" title="사진을 ZIP 파일 하나로 묶어서 저장">ZIP으로 모두 저장</button>
        <button type="button" class="btn" id="eachBtn" title="사진을 한 장씩 따로따로 저장">한 장씩 저장</button>
      </div>
      <div class="prog" id="prog" hidden><div class="bar"><i id="progBar"></i></div><p id="progTxt"></p></div>
      <p class="hint">촬영 날짜·위치 같은 사진 정보는 빠진 채로 저장돼요.</p>
    </section>
  </aside>
</div>

<dialog class="ed" id="ed" aria-label="사진 한 장 따로 조정">
  <div class="ed-in">
    <div class="ed-view">
      <div class="ed-stage" id="edStage"><canvas id="edCv"></canvas><div class="gridov" id="edGrid" hidden></div></div>
      <button type="button" class="nav prev" id="edPrev" aria-label="이전 사진" data-ico="left"></button>
      <button type="button" class="nav next" id="edNext" aria-label="다음 사진" data-ico="right"></button>
      <div class="ed-foot">
        <span id="edCount"></span>
        <button type="button" class="hold" id="edHold" data-ico="eye">누르고 있으면 원본</button>
        <button type="button" class="hold" id="edGridBtn" data-ico="grid" aria-pressed="false" title="기울기 맞출 때 쓰는 격자">격자</button>
      </div>
    </div>
    <div class="ed-side">
      <div class="ed-head"><b id="edName"></b><button type="button" class="ic" id="edClose" aria-label="닫기" data-ico="x"></button></div>
      <div class="ed-body">
        <p class="ed-mode" id="edMode"></p>
        <div id="edctl"></div>
      </div>
      <div class="ed-acts">
        <div class="two">
          <button type="button" class="btn sm" id="edFollow">전체 설정 따르기</button>
          <button type="button" class="btn sm" id="edAll">모든 사진에 적용</button>
        </div>
        <button type="button" class="btn primary" id="edSave" data-ico="down">이 사진 저장</button>
      </div>
    </div>
  </div>
</dialog>

<div class="dropcover" id="cover" hidden>여기에 놓으면 사진이 들어가요</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<input type="file" id="file" accept="image/*,.heic,.heif" multiple hidden>

<script>
(() => {
'use strict';
const $ = s => document.querySelector(s);
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const sleep = ms => new Promise(r => setTimeout(r, ms));

/* ── 아이콘 ── */
const ICON = {
  flipH: '<path d="m3 7 5 5-5 5V7"/><path d="m21 7-5 5 5 5V7"/><path d="M12 20v2M12 14v2M12 8v2M12 2v2"/>',
