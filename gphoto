  const msg = [];
  if (bad.length) msg.push(`열 수 없는 사진 ${bad.length}장은 뺐어요` + (bad.some(n => /\.hei[cf]$/i.test(n)) ? ' (아이폰 HEIC 사진은 JPG로 바꿔서 넣어 주세요)' : ''));
