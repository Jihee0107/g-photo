  const bad = [];
  for (const it of news) {
    try {
      const img = await decode(it.file);
      it.thumb = shrink(img, THUMB);
      it.ready = true;
      it.el.classList.remove('loading');
      drawCard(it);
    } catch (e) {
      bad.push(it.name);
      removeItem(it);
    } finally {
      loading--;
      refreshUI();
    }
