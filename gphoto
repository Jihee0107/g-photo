  zipBtn.disabled = eachBtn.disabled = !ready || loading > 0 || saving;
  gNote.textContent = own
    ? `따로 조정한 사진 ${own}장은 여기 설정이 적용되지 않아요.`
    : '사진을 누르면 그 사진만 따로 조정할 수 있어요.';
  const first = items[0];
  nameEx.textContent = '예) ' + outName(first ? first.name : 'IMG_1234.jpg', outMime(first ? first.file : {name: 'IMG_1234.jpg', type: 'image/jpeg'}));
}

/* 파일 넣기: 고르기 · 끌어다 놓기(폴더 포함) · 붙여넣기 */
const pick = () => fileIn.click();
addBtn.onclick = addTile.onclick = pick;
fileIn.onchange = () => { addFiles(fileIn.files); fileIn.value = ''; };
clearBtn.onclick = () => {
  if (!items.length || !confirm(`사진 ${items.length}장을 모두 뺄까요?`)) return;
  items.splice(0).forEach(it => { it.el.remove(); it.work.width = it.work.height = 0; });
  refreshUI();
};
async function walk(entries) {
  const out = [];
  async function go(en) {
    if (en.isFile) out.push(await new Promise((res, rej) => en.file(res, rej)));
    else if (en.isDirectory) {
      const r = en.createReader();
      let batch;
      do { batch = await new Promise((res, rej) => r.readEntries(res, rej)); for (const c of batch) await go(c); } while (batch.length);
    }
  }
  for (const en of entries) { try { await go(en); } catch (e) {} }
  return out;
}
const cover = $('#cover');
let dragN = 0;
const hasFiles = e => [...((e.dataTransfer && e.dataTransfer.types) || [])].includes('Files');
window.addEventListener('dragenter', e => { if (!hasFiles(e)) return; e.preventDefault(); dragN++; cover.hidden = false; });
window.addEventListener('dragover', e => { if (!hasFiles(e)) return; e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
window.addEventListener('dragleave', e => { if (!hasFiles(e)) return; dragN = Math.max(0, dragN - 1); if (!dragN) cover.hidden = true; });
window.addEventListener('drop', e => {
  if (!hasFiles(e)) return;
  e.preventDefault();
  dragN = 0; cover.hidden = true;
  if (ed.open) ed.close();
  const dt = e.dataTransfer;
  const entries = [...(dt.items || [])].map(i => i.webkitGetAsEntry && i.webkitGetAsEntry()).filter(Boolean);
  if (entries.some(en => en.isDirectory)) walk(entries).then(addFiles);
  else addFiles(dt.files);
});
window.addEventListener('paste', e => {
  const fs = [...((e.clipboardData && e.clipboardData.files) || [])].filter(f => f.type.startsWith('image/'));
  if (!fs.length) return;
  e.preventDefault();
  const t = new Date(), stamp = [t.getHours(), t.getMinutes(), t.getSeconds()].map(v => String(v).padStart(2, '0')).join('');
  addFiles(fs.map((f, i) => new File([f], `붙여넣기_${stamp}${fs.length > 1 ? '_' + (i + 1) : ''}.${(f.type.split('/')[1] || 'png').replace('jpeg', 'jpg')}`, {type: f.type, lastModified: t.getTime()})));
});

/* ── 모든 사진 설정 ── */
const gCtl = makeControls($('#gctl'), {
  get: () => G,
  set: p => { Object.assign(G, p); clean(G); persist(); gCtl.sync(); repaintAll(); }
});
$('#gReset').onclick = () => { Object.assign(G, DEF); persist(); gCtl.sync(); repaintAll(); };

/* ── 한 장 따로 조정 창 ── */
const ed = $('#ed'), edCv = $('#edCv'), edName = $('#edName'), edCount = $('#edCount'), edMode = $('#edMode');
const edPrev = $('#edPrev'), edNext = $('#edNext'), edHold = $('#edHold'), edFollow = $('#edFollow'), edAll = $('#edAll');
const edStage = $('#edStage'), edGrid = $('#edGrid'), edGridBtn = $('#edGridBtn');
let cur = null, holding = false, rafEd = 0, gridOn = false, angleDrag = false;
const edWork = mkCv(1, 1);
const mids = new Map(), midWait = new Set();   // 크게 볼 때 쓰는 중간 크기 사진 (최근 4장만)

const edCtl = makeControls($('#edctl'), {
  get: () => cur ? eff(cur) : G,
  set: p => {
    if (!cur.own) cur.own = {...G};
    Object.assign(cur.own, p);
    clean(cur.own);
    if (same(cur.own, G)) cur.own = null;
    edSync(); drawCard(cur); edRepaint(); refreshUI();
  }
});
function edSync() {
  const idx = items.indexOf(cur);
  edName.textContent = edName.title = cur.name;
  edCount.textContent = `${idx + 1} / ${items.length}`;
  edMode.textContent = cur.own ? '이 사진만 따로 조정했어요.' : '지금은 모든 사진 설정과 같아요. 여기서 바꾸면 이 사진만 바뀌어요.';
  edMode.classList.toggle('own', !!cur.own);
  edFollow.disabled = edAll.disabled = !cur.own;
  edPrev.disabled = !items.slice(0, idx).some(i => i.ready);
  edNext.disabled = !items.slice(idx + 1).some(i => i.ready);
  edCtl.sync();
}
function placeGrid() {   // 격자를 사진이 보이는 자리에만
  edGrid.hidden = !(gridOn || angleDrag) || !cur;
  if (edGrid.hidden) return;
  const st = edStage.getBoundingClientRect(), r = Math.min(st.width / edCv.width, st.height / edCv.height);
  const w = edCv.width * r, h = edCv.height * r;
  Object.assign(edGrid.style, {left: (st.width - w) / 2 + 'px', top: (st.height - h) / 2 + 'px', width: w + 'px', height: h + 'px'});
}
function edRepaint() {
  if (rafEd) return;
  rafEd = requestAnimationFrame(() => {
    rafEd = 0;
    if (!cur) return;
    const src = mids.get(cur.id) || cur.thumb;
    render(edCv, src, src.width, src.height, holding ? NEUTRAL : eff(cur), false, edWork);
    placeGrid();
  });
}
async function loadMid(it) {
  if (mids.has(it.id) || midWait.has(it.id)) return;
  midWait.add(it.id);
  try {
    const cv = shrink(await decode(it.file), MID);
    mids.set(it.id, cv);
    while (mids.size > 4) mids.delete([...mids.keys()].find(k => !cur || k !== cur.id));
    if (cur === it) edRepaint();
  } catch (e) {} finally { midWait.delete(it.id); }
}
function openEd(it) {
  cur = it;
  if (!ed.open) { ed.showModal(); $('#edClose').focus(); }
  edSync(); edRepaint();
  loadMid(it).then(() => {
    if (cur !== it) return;
    const nx = items[items.indexOf(it) + 1];
    if (nx && nx.ready) loadMid(nx);
  });
}
function go(d) {
  if (!cur) return;
  let i = items.indexOf(cur) + d;
  while (items[i] && !items[i].ready) i += d;
  if (items[i]) openEd(items[i]);
}
edPrev.onclick = () => go(-1);
edNext.onclick = () => go(1);
$('#edClose').onclick = () => ed.close();
ed.addEventListener('close', () => { cur = null; holding = false; edHold.classList.remove('on'); mids.clear(); edWork.width = edWork.height = 1; });
let downOnBackdrop = false;
ed.addEventListener('pointerdown', e => {
  downOnBackdrop = e.target === ed;
  if (e.target.matches('[data-k=angle] input[type=range]')) { angleDrag = true; placeGrid(); }   // 기울기 막대를 잡고 있는 동안 격자 보이기
});
window.addEventListener('pointerup', () => { if (angleDrag) { angleDrag = false; placeGrid(); } });
window.addEventListener('resize', () => { if (cur) placeGrid(); });
ed.addEventListener('click', e => { if (downOnBackdrop && e.target === ed) ed.close(); });
ed.addEventListener('keydown', e => {
  if (e.target.matches('input')) return;
  if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
  else if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
});
edGridBtn.onclick = () => { gridOn = !gridOn; edGridBtn.setAttribute('aria-pressed', String(gridOn)); placeGrid(); };
const holdOn = e => { if (e.button > 0 || holding) return; holding = true; edHold.classList.add('on'); edRepaint(); };
const holdOff = () => { if (!holding) return; holding = false; edHold.classList.remove('on'); edRepaint(); };
edHold.addEventListener('pointerdown', e => { if (edHold.setPointerCapture) edHold.setPointerCapture(e.pointerId); holdOn(e); });
['pointerup', 'pointercancel', 'lostpointercapture'].forEach(t => edHold.addEventListener(t, holdOff));
edHold.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); holdOn(e); } });
edHold.addEventListener('keyup', holdOff);
edHold.addEventListener('blur', holdOff);
edHold.addEventListener('contextmenu', e => e.preventDefault());
edFollow.onclick = () => { cur.own = null; edSync(); drawCard(cur); edRepaint(); refreshUI(); };
edAll.onclick = () => {
  const others = items.filter(i => i.own && i !== cur).length;
  if (others && !confirm(`따로 조정한 다른 사진 ${others}장도 이 설정으로 바뀌어요. 계속할까요?`)) return;
  Object.assign(G, cur.own);
  items.forEach(i => { i.own = null; });
  persist(); gCtl.sync();
  items.forEach(i => i.ready && drawCard(i));
  edSync(); edRepaint(); refreshUI();
  toast('모든 사진에 적용했어요');
};
$('#edSave').onclick = () => cur && saveOne(cur);

/* ── 저장 ── */
const fmtBtns = document.querySelectorAll('[data-fmt]'), sizeBtns = document.querySelectorAll('[data-size]');
function syncSave() {
  fmtBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.fmt === fmt)));
  sizeBtns.forEach(b => b.setAttribute('aria-pressed', String(+b.dataset.size === size)));
}
fmtBtns.forEach(b => b.onclick = () => { fmt = b.dataset.fmt; persist(); syncSave(); refreshUI(); });
sizeBtns.forEach(b => b.onclick = () => { size = +b.dataset.size; persist(); syncSave(); });
suffixIn.value = suffix;
suffixIn.oninput = () => { suffix = suffixIn.value.replace(/[\\/:*?"<>|]/g, ''); persist(); refreshUI(); };

function outMime(file) {
  if (fmt === 'jpg') return 'image/jpeg';
  if (fmt === 'png') return 'image/png';
  const t = (file.type || '').toLowerCase(), n = file.name || '';
  if (t === 'image/png' || /\.png$/i.test(n)) return 'image/png';
  if (t === 'image/webp' || /\.webp$/i.test(n)) return 'image/webp';
  return 'image/jpeg';
}
function outName(name, mime) {
  const base = name.replace(/\.[^.]+$/, '') || '사진';
  return (base + suffix).replace(/[\\/:*?"<>|]/g, '_') + EXT[mime];
}

/* 저장용 처리(보정+반전+JPG 변환)는 백그라운드(워커)에서 여러 장 동시에 — 화면이 안 멈추고 훨씬 빠름. 안 되면 화면에서 처리 */
const ENC_SRC = [mkCv, geom, blurData, develop, paintGeom, render].map(String).join('\n')
  + '\nonmessage=async e=>{const d=e.data;try{const c=new OffscreenCanvas(1,1);render(c,d.bmp,d.bmp.width,d.bmp.height,d.s,d.bg);d.bmp.close();'
  + 'postMessage({id:d.id,b:await c.convertToBlob({type:d.type,quality:d.q})})}catch(err){postMessage({id:d.id,err:String(err)})}}';
let workers = null, workerBroken = false, encSeq = 0;
function getWorkers() {
  if (workerBroken) return [];
  if (!workers) {
    workers = [];
    try {
      if (typeof OffscreenCanvas !== 'function' || !OffscreenCanvas.prototype.convertToBlob) throw 0;
      const url = URL.createObjectURL(new Blob([ENC_SRC], {type: 'text/javascript'}));
      const n = clamp((navigator.hardwareConcurrency || 4) - 1, 1, 3);
      for (let i = 0; i < n; i++) workers.push(new Worker(url));
    } catch (e) { workers = []; workerBroken = true; }
  }
  return workers;
}
function workerRun(w, msg, transfer) {
  return new Promise((res, rej) => {
    const id = ++encSeq;
    const done = (fn, v) => { clearTimeout(tm); w.removeEventListener('message', onMsg); w.removeEventListener('error', onErr); fn(v); };
    const onMsg = e => { if (e.data.id !== id) return; e.data.b ? done(res, e.data.b) : done(rej, new Error(e.data.err)); };
    const onErr = e => { e.preventDefault(); done(rej, new Error('worker')); };
    const tm = setTimeout(() => done(rej, new Error('timeout')), 60000);
    w.addEventListener('message', onMsg);
    w.addEventListener('error', onErr);
    w.postMessage({...msg, id}, transfer);
  });
}
async function renderFull(it, worker) {
  const img = await decode(it.file), mime = outMime(it.file), s = {...eff(it)}, bg = mime === 'image/jpeg';
  const nw = img.naturalWidth, nh = img.naturalHeight, g = geom(nw, nh, s);
  const sc = size ? Math.min(1, size / Math.max(g.ow, g.oh)) : 1;   // 크기: 결과 사진의 긴 쪽 기준
  const w = Math.max(1, Math.round(nw * sc)), h = Math.max(1, Math.round(nh * sc));
  const prep = () => { const c = mkCv(w, h), x = c.getContext('2d'); x.imageSmoothingQuality = 'high'; x.drawImage(img, 0, 0, w, h); return c; };
  let blob = null;
  if (worker && !workerBroken) {
    try {
      const c = prep(), bmp = await createImageBitmap(c);
      c.width = c.height = 0;
      blob = await workerRun(worker, {bmp, s, bg, type: mime, q: 0.92}, [bmp]);
    } catch (e) { workerBroken = true; blob = null; }
  }
  if (!blob) {
    const src = sc < 1 ? prep() : img;
    const cv = render(mkCv(1, 1), src, w, h, s, bg);
    blob = await new Promise(r => cv.toBlob(r, mime, 0.92));
    cv.width = cv.height = 0;
    if (src !== img) src.width = src.height = 0;
  }
  if (!blob) throw new Error('encode');
  return {blob, name: outName(it.name, mime)};
}
function download(blob, name) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 60000);
}
function uniq(name, used) {
  let n = name, i = 2;
  while (used.has(n.toLowerCase())) n = name.replace(/(\.[^.]+)$/, ` (${i++})$1`);
  used.add(n.toLowerCase());
  return n;
}
async function saveOne(it) {
  try {
    const r = await renderFull(it, getWorkers()[0]);
    download(r.blob, r.name);
    toast(`저장했어요 · ${r.name}`);
  } catch (e) { toast('이 사진은 저장하지 못했어요. 사진이 너무 크면 PNG 대신 JPG로 해 보세요.', 4200); }
}
function showProg(done, total, text) {
  prog.hidden = false;
  progBar.style.width = (total ? done / total * 100 : 0) + '%';
  progTxt.textContent = text || `만드는 중… ${done} / ${total}`;
}
async function saveAll(zip) {
  const list = items.filter(i => i.ready);
  if (!list.length || saving) return;
  saving = true; refreshUI();
  if (!zip) toast('크롬이 "여러 파일 다운로드"를 물으면 허용을 눌러 주세요', 4200);
  const W = getWorkers(), results = [], used = new Set();
  let next = 0, doneN = 0;
  showProg(0, list.length);
  const lane = async w => {   // 여러 장을 동시에 (워커 하나당 한 줄)
    while (next < list.length) {
      const i = next++;
      try { results[i] = await renderFull(list[i], w); } catch (e) { results[i] = null; }
      showProg(++doneN, list.length);
    }
  };
  await Promise.all(W.length ? W.map(lane) : [lane(), lane()]);
  const out = results.filter(Boolean);
  out.forEach(r => { r.name = uniq(r.name, used); });
  const fail = list.length - out.length, okN = out.length;
  if (!zip) {
    for (let i = 0; i < out.length; i++) {
      showProg(i + 1, out.length, `내려받는 중… ${i + 1} / ${out.length}`);
      download(out[i].blob, out[i].name);
      await sleep(350);
    }
  }
  if (zip && out.length) {
    showProg(list.length, list.length, 'ZIP 파일로 묶는 중…');
    const t = new Date(), ymd = t.getFullYear() + String(t.getMonth() + 1).padStart(2, '0') + String(t.getDate()).padStart(2, '0');
    download(await makeZip(out), `사진_${out.length}장_${ymd}.zip`);
  }
  showProg(list.length, list.length, okN ? `${okN}장 저장 완료` + (fail ? ` · ${fail}장 실패` : '') : '저장하지 못했어요');
  if (fail) toast(`${fail}장은 저장하지 못했어요. 너무 큰 사진이면 JPG로 해 보세요.`, 4200);
  saving = false; refreshUI();
}
zipBtn.onclick = () => saveAll(true);
eachBtn.onclick = () => saveAll(false);

/* ZIP 만들기 (압축 없이 묶기만 — 사진은 이미 압축돼 있어서 크기 차이 없음) */
const CRC_T = (() => { const t = new Uint32Array(256); for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xEDB88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();
function crc32(u8) { let c = 0xFFFFFFFF; for (let i = 0; i < u8.length; i++) c = CRC_T[(c ^ u8[i]) & 255] ^ (c >>> 8); return (c ^ 0xFFFFFFFF) >>> 0; }
async function makeZip(files) {
  const enc = new TextEncoder(), now = new Date(), parts = [], central = [];
  const time = (now.getHours() << 11) | (now.getMinutes() << 5) | (now.getSeconds() >> 1);
  const date = ((now.getFullYear() - 1980) << 9) | ((now.getMonth() + 1) << 5) | now.getDate();
  let offset = 0, cdSize = 0;
  for (const f of files) {
    const nm = enc.encode(f.name), crc = crc32(new Uint8Array(await f.blob.arrayBuffer())), sz = f.blob.size;
    const lh = new DataView(new ArrayBuffer(30));
    lh.setUint32(0, 0x04034b50, true); lh.setUint16(4, 20, true); lh.setUint16(6, 0x0800, true);   // 0x0800 = 파일 이름 UTF-8 (한글 이름)
    lh.setUint16(10, time, true); lh.setUint16(12, date, true); lh.setUint32(14, crc, true);
    lh.setUint32(18, sz, true); lh.setUint32(22, sz, true); lh.setUint16(26, nm.length, true);
    parts.push(lh.buffer, nm, f.blob);
    const ch = new DataView(new ArrayBuffer(46));
    ch.setUint32(0, 0x02014b50, true); ch.setUint16(4, 20, true); ch.setUint16(6, 20, true); ch.setUint16(8, 0x0800, true);
    ch.setUint16(12, time, true); ch.setUint16(14, date, true); ch.setUint32(16, crc, true);
    ch.setUint32(20, sz, true); ch.setUint32(24, sz, true); ch.setUint16(28, nm.length, true); ch.setUint32(42, offset, true);
    central.push(ch.buffer, nm);
    offset += 30 + nm.length + sz;
    cdSize += 46 + nm.length;
  }
  const end = new DataView(new ArrayBuffer(22));
  end.setUint32(0, 0x06054b50, true); end.setUint16(8, files.length, true); end.setUint16(10, files.length, true);
  end.setUint32(12, cdSize, true); end.setUint32(16, offset, true);
  return new Blob([...parts, ...central, end.buffer], {type: 'application/zip'});
}

/* ── 알림 ── */
const toastEl = $('#toast');
let toastT = 0;
function toast(msg, ms = 2600) {
  const host = ed.open ? ed : document.body;   // 조정 창이 열려 있으면 창 안에 띄움
  if (toastEl.parentNode !== host) host.appendChild(toastEl);
  toastEl.textContent = msg;
  void toastEl.offsetWidth;   // 옮긴 직후에도 나타나는 효과가 보이게
  toastEl.classList.add('show');
  clearTimeout(toastT);
  toastT = setTimeout(() => toastEl.classList.remove('show'), ms);
}

syncSave();
refreshUI();
})();
</script>
